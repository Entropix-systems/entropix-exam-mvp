NODE_ENV=development

WEB_PORT=5173
API_PORT=3000
WORKER_PORT=3001

WEB_ORIGIN=http://localhost:5173
API_BASE_URL=http://localhost:3000/api/v1

# Local Docker defaults. Passwords must match .env.docker.
DATABASE_URL=postgresql://exam_app:change-me-app@127.0.0.1:55432/exam_mvp
DATABASE_MIGRATION_URL=postgresql://exam_migration:change-me-migration@127.0.0.1:55432/exam_mvp
SHADOW_DATABASE_URL=postgresql://exam_migration:change-me-migration@127.0.0.1:55432/exam_mvp_shadow
DATABASE_SSL_CA_PATH=
# Optional override when the disposable local demo database is not named exam_mvp.
DEMO_LOCAL_DATABASE_NAME=exam_mvp
# Optional override when disposable local PostgreSQL does not use the Compose port.
DEMO_LOCAL_DATABASE_PORT=55432

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
INVITE_TTL_SECONDS=86400
# Phase 1 implementation default; configurable, not a prior frozen requirement.
PASSWORD_RESET_TTL_SECONDS=1800

ACCESS_TOKEN_SECRET=change-me-access-token-secret-at-least-32-characters
REFRESH_TOKEN_PEPPER=change-me-refresh-token-pepper-at-least-32-characters

STORAGE_PROVIDER=s3
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET=exam-private
STORAGE_FORCE_PATH_STYLE=true
STORAGE_SIGNED_URL_TTL_SECONDS=60

EMAIL_PROVIDER=test
EMAIL_FROM=
EMAIL_REGION=

SCANNER_HOST=
SCANNER_PORT=

LOG_LEVEL=info

EMAIL_TEST_MODE=ACCEPT
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
