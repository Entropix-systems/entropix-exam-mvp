{
  "name": "@entropix/storage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "tsx scripts/storage-smoke.ts",
    "smoke:private-documents": "tsx scripts/private-document-smoke.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1129.0",
    "@aws-sdk/s3-request-presigner": "^3.1129.0",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "typescript": "6.0.3"
  }
}
