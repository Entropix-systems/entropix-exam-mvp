generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  status    String   @default("ACTIVE")
  timezone  String
  plan      String   @default("MVP")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships           Membership[]
  campuses              Campus[]
  departments           Department[]
  programs              Program[]
  academicYears         AcademicYear[]
  terms                 Term[]
  cohorts               Cohort[]
  subjects              Subject[]
  students              Student[]
  faculty               Faculty[]
  enrolments            Enrolment[]
  studentImports        StudentImport[]
  ruleVersions          RuleVersion[]
  exams                 Exam[]
  examSubjects          ExamSubject[]
  registrations         Registration[]
  registrationSubjects  RegistrationSubject[]
  examPapers            ExamPaper[]
  halls                 Hall[]
  hallSittings          HallSitting[]
  seatAssignments       SeatAssignment[]
  duties                Duty[]
  attendanceBatches     AttendanceBatch[]
  attendanceRows        Attendance[]
  incidents             Incident[]
  incidentStudents      IncidentStudent[]
  evaluationAssignments EvaluationAssignment[]
  marksBatches          MarksBatch[]
  marks                 Mark[]
  resultRuns            ResultRun[]
  resultItems           ResultItem[]
  studentResults        StudentResult[]
  publications          Publication[]
  auditEvents           AuditEvent[]

  @@map("tenants")
}

model Campus {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  code      String
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  departments Department[]
  halls       Hall[]

  @@unique([tenantId, id], map: "campuses_tenant_id_id_key")
  @@unique([tenantId, code], map: "campuses_tenant_code_key")
  @@index([tenantId])
  @@map("campuses")
}

model Department {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  campusId  String   @map("campus_id") @db.Uuid
  code      String
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  campus   Campus    @relation(fields: [tenantId, campusId], references: [tenantId, id], onDelete: Restrict)
  programs Program[]
  faculty  Faculty[]

  @@unique([tenantId, id], map: "departments_tenant_id_id_key")
  @@unique([tenantId, campusId, code], map: "departments_tenant_campus_code_key")
  @@index([tenantId])
  @@index([tenantId, campusId])
  @@map("departments")
}

model Program {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  departmentId String   @map("department_id") @db.Uuid
  code         String
  name         String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  department Department @relation(fields: [tenantId, departmentId], references: [tenantId, id], onDelete: Restrict)
  terms      Term[]
  subjects   Subject[]

  @@unique([tenantId, id], map: "programs_tenant_id_id_key")
  @@unique([tenantId, departmentId, code], map: "programs_tenant_department_code_key")
  @@index([tenantId])
  @@index([tenantId, departmentId])
  @@map("programs")
}

model AcademicYear {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  code      String
  name      String
  startsOn  DateTime @map("starts_on") @db.Date
  endsOn    DateTime @map("ends_on") @db.Date
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  terms  Term[]

  @@unique([tenantId, id], map: "academic_years_tenant_id_id_key")
  @@unique([tenantId, code], map: "academic_years_tenant_code_key")
  @@index([tenantId])
  @@map("academic_years")
}

model Term {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  programId      String   @map("program_id") @db.Uuid
  academicYearId String   @map("academic_year_id") @db.Uuid
  code           String
  name           String
  startsOn       DateTime @map("starts_on") @db.Date
  endsOn         DateTime @map("ends_on") @db.Date
  sequence       Int
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  program      Program      @relation(fields: [tenantId, programId], references: [tenantId, id], onDelete: Restrict)
  academicYear AcademicYear @relation(fields: [tenantId, academicYearId], references: [tenantId, id], onDelete: Restrict)
  cohorts      Cohort[]
  exams        Exam[]

  @@unique([tenantId, id], map: "terms_tenant_id_id_key")
  @@unique([tenantId, programId, academicYearId, code], map: "terms_tenant_program_year_code_key")
  @@unique([tenantId, programId, academicYearId, sequence], map: "terms_tenant_program_year_sequence_key")
  @@index([tenantId])
  @@index([tenantId, programId])
  @@index([tenantId, academicYearId])
  @@map("terms")
}

model Cohort {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  termId    String   @map("term_id") @db.Uuid
  code      String
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  term       Term        @relation(fields: [tenantId, termId], references: [tenantId, id], onDelete: Restrict)
  students   Student[]
  enrolments Enrolment[]

  @@unique([tenantId, id], map: "cohorts_tenant_id_id_key")
  @@unique([tenantId, termId, code], map: "cohorts_tenant_term_code_key")
  @@index([tenantId])
  @@index([tenantId, termId])
  @@map("cohorts")
}

model Subject {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  programId String   @map("program_id") @db.Uuid
  code      String
  name      String
  credits   Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  program      Program       @relation(fields: [tenantId, programId], references: [tenantId, id], onDelete: Restrict)
  enrolments   Enrolment[]
  examSubjects ExamSubject[]

  @@unique([tenantId, id], map: "subjects_tenant_id_id_key")
  @@unique([tenantId, programId, code], map: "subjects_tenant_program_code_key")
  @@index([tenantId])
  @@index([tenantId, programId])
  @@map("subjects")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String?  @map("password_hash")
  status       String   @default("ACTIVE")
  platformRole String?  @map("platform_role")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  memberships Membership[]
  sessions    Session[]
  authTokens  AuthToken[]

  @@map("users")
}

model Membership {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  status    String   @default("ACTIVE")
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  roleGrants            RoleGrant[]
  sessions              Session[]
  authTokens            AuthToken[]
  student               Student?
  faculty               Faculty?
  reviewedRegistrations Registration[]         @relation("RegistrationReviewer")
  assignedDuties        Duty[]                 @relation("DutyAssigner")
  respondedDuties       Duty[]                 @relation("DutyResponder")
  updatedAttendance     Attendance[]           @relation("AttendanceUpdater")
  submittedAttendance   AttendanceBatch[]      @relation("AttendanceSubmitter")
  reopenedAttendance    AttendanceBatch[]      @relation("AttendanceReopener")
  createdIncidents      Incident[]             @relation("IncidentCreator")
  disposedIncidents     Incident[]             @relation("IncidentDisposer")
  assignedEvaluations   EvaluationAssignment[] @relation("EvaluationAssigner")
  submittedMarksBatches MarksBatch[]           @relation("MarksBatchSubmitter")
  reviewedMarksBatches  MarksBatch[]           @relation("MarksBatchReviewer")
  reopenedMarksBatches  MarksBatch[]           @relation("MarksBatchReopener")
  updatedMarks          Mark[]                 @relation("MarkUpdater")
  computedResultRuns    ResultRun[]            @relation("ResultRunComputer")
  publishedResults      Publication[]          @relation("PublicationPublisher")
  withdrawnResults      Publication[]          @relation("PublicationWithdrawer")
  auditEvents           AuditEvent[]            @relation("AuditEventActor")

  @@unique([tenantId, userId], map: "memberships_tenant_user_key")
  @@unique([tenantId, id], map: "memberships_tenant_id_id_key")
  @@unique([tenantId, id, userId], map: "memberships_tenant_id_user_id_key")
  @@index([tenantId])
  @@index([userId])
  @@map("memberships")
}

model Student {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  membershipId String   @map("membership_id") @db.Uuid
  cohortId     String   @map("cohort_id") @db.Uuid
  rollNo       String   @map("roll_no")
  name         String
  email        String
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  membership    Membership     @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Restrict)
  cohort        Cohort         @relation(fields: [tenantId, cohortId], references: [tenantId, id], onDelete: Restrict)
  enrolments    Enrolment[]
  registrations Registration[]
  resultItems   ResultItem[]
  results       StudentResult[]

  @@unique([tenantId, id], map: "students_tenant_id_id_key")
  @@unique([tenantId, id, cohortId], map: "students_tenant_id_cohort_id_key")
  @@unique([tenantId, membershipId], map: "students_tenant_membership_key")
  @@unique([tenantId, rollNo], map: "students_tenant_roll_no_key")
  @@index([tenantId, cohortId])
  @@map("students")
}

model Faculty {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  membershipId String   @map("membership_id") @db.Uuid
  departmentId String   @map("department_id") @db.Uuid
  code         String
  name         String
  email        String
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  membership            Membership             @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Restrict)
  department            Department             @relation(fields: [tenantId, departmentId], references: [tenantId, id], onDelete: Restrict)
  duties                Duty[]
  evaluationAssignments EvaluationAssignment[]

  @@unique([tenantId, id], map: "faculty_tenant_id_id_key")
  @@unique([tenantId, membershipId], map: "faculty_tenant_membership_key")
  @@unique([tenantId, code], map: "faculty_tenant_code_key")
  @@index([tenantId, departmentId])
  @@map("faculty")
}

model Enrolment {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  studentId String   @map("student_id") @db.Uuid
  cohortId  String   @map("cohort_id") @db.Uuid
  subjectId String   @map("subject_id") @db.Uuid
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  student              Student               @relation(fields: [tenantId, studentId, cohortId], references: [tenantId, id, cohortId], onDelete: Restrict)
  cohort               Cohort                @relation(fields: [tenantId, cohortId], references: [tenantId, id], onDelete: Restrict)
  subject              Subject               @relation(fields: [tenantId, subjectId], references: [tenantId, id], onDelete: Restrict)
  registrationSubjects RegistrationSubject[]

  @@unique([tenantId, studentId, subjectId, cohortId], map: "enrolments_tenant_student_subject_cohort_key")
  @@unique([tenantId, id], map: "enrolments_tenant_id_id_key")
  @@index([tenantId, cohortId, subjectId])
  @@map("enrolments")
}

model StudentImport {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  contentHash    String   @map("content_hash")
  fileName       String   @map("file_name")
  rowCount       Int      @map("row_count")
  createdCount   Int      @map("created_count")
  enrolmentCount Int      @map("enrolment_count")
  committedAt    DateTime @default(now()) @map("committed_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id], map: "student_imports_tenant_id_id_key")
  @@unique([tenantId, contentHash], map: "student_imports_tenant_content_hash_key")
  @@index([tenantId, committedAt])
  @@map("student_imports")
}

model RuleVersion {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  version   Int
  config    Json
  frozenAt  DateTime? @map("frozen_at")
  createdAt DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  exams  Exam[]
  resultRuns ResultRun[]

  @@unique([tenantId, id], map: "rule_versions_tenant_id_id_key")
  @@unique([tenantId, version], map: "rule_versions_tenant_version_key")
  @@index([tenantId])
  @@map("rule_versions")
}

model Exam {
  id                   String   @id @default(uuid()) @db.Uuid
  tenantId             String   @map("tenant_id") @db.Uuid
  termId               String   @map("term_id") @db.Uuid
  ruleVersionId        String   @map("rule_version_id") @db.Uuid
  code                 String
  name                 String
  registrationMode     String   @map("registration_mode")
  state                String   @default("DRAFT")
  registrationOpensAt  DateTime @map("registration_opens_at")
  registrationClosesAt DateTime @map("registration_closes_at")
  version              Int      @default(1)
  scheduleRevision     Int      @default(0) @map("schedule_revision")
  inputRevision        Int      @default(0) @map("input_revision")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  term          Term           @relation(fields: [tenantId, termId], references: [tenantId, id], onDelete: Restrict)
  ruleVersion   RuleVersion    @relation(fields: [tenantId, ruleVersionId], references: [tenantId, id], onDelete: Restrict)
  subjects      ExamSubject[]
  registrations Registration[]
  papers        ExamPaper[]
  resultRuns    ResultRun[]
  studentResults StudentResult[]
  publications  Publication[]

  @@unique([tenantId, id], map: "exams_tenant_id_id_key")
  @@unique([tenantId, termId, code], map: "exams_tenant_term_code_key")
  @@index([tenantId, termId])
  @@map("exams")
}

model ExamSubject {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  examId    String   @map("exam_id") @db.Uuid
  subjectId String   @map("subject_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  exam                 Exam                  @relation(fields: [tenantId, examId], references: [tenantId, id], onDelete: Restrict)
  subject              Subject               @relation(fields: [tenantId, subjectId], references: [tenantId, id], onDelete: Restrict)
  registrationSubjects RegistrationSubject[]
  paper                ExamPaper?
  evaluationAssignment EvaluationAssignment?
  marksBatch           MarksBatch?

  @@unique([tenantId, id], map: "exam_subjects_tenant_id_id_key")
  @@unique([tenantId, id, examId], map: "exam_subjects_tenant_id_exam_id_key")
  @@unique([tenantId, examId, subjectId], map: "exam_subjects_tenant_exam_subject_key")
  @@index([tenantId, subjectId])
  @@map("exam_subjects")
}

model Registration {
  id                          String    @id @default(uuid()) @db.Uuid
  tenantId                    String    @map("tenant_id") @db.Uuid
  examId                      String    @map("exam_id") @db.Uuid
  studentId                   String    @map("student_id") @db.Uuid
  state                       String    @default("DRAFT")
  version                     Int       @default(1)
  controllerEligible          Boolean   @default(true) @map("controller_eligible")
  controllerEligibilityReason String?   @map("controller_eligibility_reason")
  eligibilitySnapshot         Json?     @map("eligibility_snapshot")
  submittedAt                 DateTime? @map("submitted_at")
  reviewedByMembershipId      String?   @map("reviewed_by_membership_id") @db.Uuid
  reviewedAt                  DateTime? @map("reviewed_at")
  decisionReason              String?   @map("decision_reason")
  createdAt                   DateTime  @default(now()) @map("created_at")
  updatedAt                   DateTime  @updatedAt @map("updated_at")

  tenant   Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  exam     Exam                  @relation(fields: [tenantId, examId], references: [tenantId, id], onDelete: Restrict)
  student  Student               @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Restrict)
  reviewer Membership?           @relation("RegistrationReviewer", fields: [tenantId, reviewedByMembershipId], references: [tenantId, id], onDelete: Restrict)
  subjects RegistrationSubject[]

  @@unique([tenantId, id], map: "registrations_tenant_id_id_key")
  @@unique([tenantId, id, examId], map: "registrations_tenant_id_exam_id_key")
  @@unique([tenantId, examId, studentId], map: "registrations_tenant_exam_student_key")
  @@index([tenantId, state])
  @@map("registrations")
}

model RegistrationSubject {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  registrationId String   @map("registration_id") @db.Uuid
  examId         String   @map("exam_id") @db.Uuid
  examSubjectId  String   @map("exam_subject_id") @db.Uuid
  enrolmentId    String   @map("enrolment_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  registration     Registration      @relation(fields: [tenantId, registrationId, examId], references: [tenantId, id, examId], onDelete: Cascade)
  examSubject      ExamSubject       @relation(fields: [tenantId, examSubjectId, examId], references: [tenantId, id, examId], onDelete: Restrict)
  enrolment        Enrolment         @relation(fields: [tenantId, enrolmentId], references: [tenantId, id], onDelete: Restrict)
  seatAssignments  SeatAssignment[]
  incidentStudents IncidentStudent[]
  marks            Mark[]
  resultItems      ResultItem[]

  @@unique([tenantId, id], map: "registration_subjects_tenant_id_id_key")
  @@unique([tenantId, id, examSubjectId], map: "registration_subjects_tenant_id_exam_subject_id_key")
  @@unique([tenantId, registrationId, examSubjectId], map: "registration_subjects_tenant_registration_exam_subject_key")
  @@index([tenantId, examId, examSubjectId])
  @@map("registration_subjects")
}

model ExamPaper {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  examId        String    @map("exam_id") @db.Uuid
  examSubjectId String    @map("exam_subject_id") @db.Uuid
  startsAt      DateTime? @map("starts_at")
  endsAt        DateTime? @map("ends_at")
  version       Int       @default(1)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  exam            Exam             @relation(fields: [tenantId, examId], references: [tenantId, id], onDelete: Restrict)
  examSubject     ExamSubject      @relation(fields: [tenantId, examSubjectId, examId], references: [tenantId, id, examId], onDelete: Restrict)
  hallSittings    HallSitting[]
  seatAssignments SeatAssignment[]

  @@unique([tenantId, id], map: "exam_papers_tenant_id_id_key")
  @@unique([tenantId, id, examSubjectId], map: "exam_papers_tenant_id_exam_subject_id_key")
  @@unique([tenantId, examSubjectId, examId], map: "exam_papers_tenant_exam_subject_exam_key")
  @@unique([tenantId, examSubjectId], map: "exam_papers_tenant_exam_subject_key")
  @@index([tenantId, examId, startsAt, endsAt])
  @@map("exam_papers")
}

model Hall {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  campusId  String   @map("campus_id") @db.Uuid
  code      String
  name      String
  capacity  Int
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  campus   Campus        @relation(fields: [tenantId, campusId], references: [tenantId, id], onDelete: Restrict)
  sittings HallSitting[]

  @@unique([tenantId, id], map: "halls_tenant_id_id_key")
  @@unique([tenantId, campusId, code], map: "halls_tenant_campus_code_key")
  @@index([tenantId, campusId])
  @@map("halls")
}

model HallSitting {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  examPaperId String   @map("exam_paper_id") @db.Uuid
  hallId      String   @map("hall_id") @db.Uuid
  roomOrder   Int      @map("room_order")
  version     Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  examPaper       ExamPaper        @relation(fields: [tenantId, examPaperId], references: [tenantId, id], onDelete: Cascade)
  hall            Hall             @relation(fields: [tenantId, hallId], references: [tenantId, id], onDelete: Restrict)
  seatAssignments SeatAssignment[]
  duties          Duty[]
  attendanceBatch AttendanceBatch?
  incidents       Incident[]

  @@unique([tenantId, id], map: "hall_sittings_tenant_id_id_key")
