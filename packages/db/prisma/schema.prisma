generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  status    String   @default("ACTIVE")
  timezone  String
  plan      String   @default("MVP")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships   Membership[]
  campuses      Campus[]
  departments   Department[]
  programs      Program[]
  academicYears AcademicYear[]
  terms         Term[]
  cohorts       Cohort[]
  subjects      Subject[]

  @@map("tenants")
}

model Campus {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  code      String
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  departments Department[]

  @@unique([tenantId, id], map: "campuses_tenant_id_id_key")
  @@unique([tenantId, code], map: "campuses_tenant_code_key")
  @@index([tenantId])
  @@map("campuses")
}

model Department {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  campusId  String   @map("campus_id") @db.Uuid
  code      String
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  campus   Campus    @relation(fields: [tenantId, campusId], references: [tenantId, id], onDelete: Restrict)
  programs Program[]

  @@unique([tenantId, id], map: "departments_tenant_id_id_key")
  @@unique([tenantId, campusId, code], map: "departments_tenant_campus_code_key")
  @@index([tenantId])
  @@index([tenantId, campusId])
  @@map("departments")
}

model Program {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  departmentId String   @map("department_id") @db.Uuid
  code         String
  name         String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  department Department @relation(fields: [tenantId, departmentId], references: [tenantId, id], onDelete: Restrict)
  terms      Term[]
  subjects   Subject[]

  @@unique([tenantId, id], map: "programs_tenant_id_id_key")
  @@unique([tenantId, departmentId, code], map: "programs_tenant_department_code_key")
  @@index([tenantId])
  @@index([tenantId, departmentId])
  @@map("programs")
}

model AcademicYear {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  code      String
  name      String
  startsOn  DateTime @map("starts_on") @db.Date
  endsOn    DateTime @map("ends_on") @db.Date
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  terms  Term[]

  @@unique([tenantId, id], map: "academic_years_tenant_id_id_key")
  @@unique([tenantId, code], map: "academic_years_tenant_code_key")
  @@index([tenantId])
  @@map("academic_years")
}

model Term {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  programId      String   @map("program_id") @db.Uuid
  academicYearId String   @map("academic_year_id") @db.Uuid
  code           String
  name           String
  startsOn       DateTime @map("starts_on") @db.Date
  endsOn         DateTime @map("ends_on") @db.Date
  sequence       Int
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  program      Program      @relation(fields: [tenantId, programId], references: [tenantId, id], onDelete: Restrict)
  academicYear AcademicYear @relation(fields: [tenantId, academicYearId], references: [tenantId, id], onDelete: Restrict)
  cohorts      Cohort[]

  @@unique([tenantId, id], map: "terms_tenant_id_id_key")
  @@unique([tenantId, programId, academicYearId, code], map: "terms_tenant_program_year_code_key")
  @@unique([tenantId, programId, academicYearId, sequence], map: "terms_tenant_program_year_sequence_key")
  @@index([tenantId])
  @@index([tenantId, programId])
  @@index([tenantId, academicYearId])
  @@map("terms")
}

model Cohort {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  termId    String   @map("term_id") @db.Uuid
  code      String
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  term   Term   @relation(fields: [tenantId, termId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id], map: "cohorts_tenant_id_id_key")
  @@unique([tenantId, termId, code], map: "cohorts_tenant_term_code_key")
  @@index([tenantId])
  @@index([tenantId, termId])
  @@map("cohorts")
}

model Subject {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  programId String   @map("program_id") @db.Uuid
  code      String
  name      String
  credits   Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  program Program @relation(fields: [tenantId, programId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id], map: "subjects_tenant_id_id_key")
  @@unique([tenantId, programId, code], map: "subjects_tenant_program_code_key")
  @@index([tenantId])
  @@index([tenantId, programId])
  @@map("subjects")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String?  @map("password_hash")
  status       String   @default("ACTIVE")
  platformRole String?  @map("platform_role")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  memberships Membership[]
  sessions    Session[]
  authTokens  AuthToken[]

  @@map("users")
}

model Membership {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  status    String   @default("ACTIVE")
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user       User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  roleGrants RoleGrant[]
  sessions   Session[]
  authTokens AuthToken[]

  @@unique([tenantId, userId], map: "memberships_tenant_user_key")
  @@unique([tenantId, id], map: "memberships_tenant_id_id_key")
  @@unique([tenantId, id, userId], map: "memberships_tenant_id_user_id_key")
  @@index([tenantId])
  @@index([userId])
  @@map("memberships")
}

model RoleGrant {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  membershipId String   @map("membership_id") @db.Uuid
  role         String
  departmentId String?  @map("department_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  membership Membership @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, membershipId, role, departmentId], map: "role_grants_scope_key")
  @@index([tenantId, membershipId, role, departmentId], map: "role_grants_scope_idx")
  @@index([tenantId])
  @@index([membershipId])
  @@map("role_grants")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  kind             String
  tenantId         String?   @map("tenant_id") @db.Uuid
  membershipId     String?   @map("membership_id") @db.Uuid
  expiresAt        DateTime  @map("expires_at")
  lastUsedAt       DateTime? @map("last_used_at")
  revokedAt        DateTime? @map("revoked_at")
  revocationReason String?   @map("revocation_reason")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  membership Membership? @relation(fields: [tenantId, membershipId, userId], references: [tenantId, id, userId], onDelete: Restrict)
  authTokens AuthToken[]

  @@index([userId])
  @@index([tenantId, membershipId])
  @@index([expiresAt])
  @@map("sessions")
}

model AuthToken {
  id            String    @id @default(uuid()) @db.Uuid
  tokenHash     String    @unique @map("token_hash")
  purpose       String
  userId        String    @map("user_id") @db.Uuid
  sessionId     String?   @map("session_id") @db.Uuid
  tenantId      String?   @map("tenant_id") @db.Uuid
  membershipId  String?   @map("membership_id") @db.Uuid
  predecessorId String?   @unique @map("predecessor_id") @db.Uuid
  expiresAt     DateTime  @map("expires_at")
  consumedAt    DateTime? @map("consumed_at")
  revokedAt     DateTime? @map("revoked_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  session     Session?    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  membership  Membership? @relation(fields: [tenantId, membershipId, userId], references: [tenantId, id, userId], onDelete: Restrict)
  predecessor AuthToken?  @relation("RefreshRotation", fields: [predecessorId], references: [id], onDelete: Restrict)
  successor   AuthToken?  @relation("RefreshRotation")

  @@index([userId, purpose])
  @@index([sessionId])
  @@index([tenantId, membershipId])
  @@index([purpose, expiresAt])
  @@map("auth_tokens")
}
